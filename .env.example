# Copy to .env for local runs. On Railway, set these under the service's Variables tab.
SECRET_KEY=change-me-to-a-long-random-string
# Admin WhatsApp numbers (comma separated, 10-digit Indian numbers are fine)
ADMIN_PHONES=9000000001
# Public URL of the site, used in WhatsApp links (must be https for media in promotions)
PUBLIC_BASE_URL=http://localhost:5000
# Dates and "tomorrow's class" reminders follow this timezone
TZ=Asia/Kolkata

# Supabase Postgres (Project Settings > Database > Connection string > Session pooler).
# Leave empty to use a local SQLite file instead.
DATABASE_URL=
# Supabase Storage for uploaded photos/videos (Project Settings > API). Leave empty to store files locally.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=uploads

# WhatsApp: console (default, nothing is sent) | twilio | meta
WHATSAPP_PROVIDER=console
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Meta WhatsApp Business Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=

# Set to 0 to start with an empty database instead of sample classes
SEED_SAMPLE_DATA=1
# Supabase's free plan caps each file at 50 MB
MAX_UPLOAD_MB=50
